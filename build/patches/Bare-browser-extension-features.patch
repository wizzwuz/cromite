+#include "extensions/browser/extension_registry_observer.h"
+
+namespace extensions {
+
+namespace {
+
+constexpr char kUBlockOriginId[] = "cjpalhdlnbpafiamejdnhcphjbkeiagm";
+constexpr char kUBlockOriginVersion[] = "1.75.0";
+constexpr char kUBlockOriginAsset[] = "assets/bare/ublock_origin.crx";
+
+constexpr base::FilePath::CharType kUBlockOriginCrx[] =
+    FILE_PATH_LITERAL("ublock_origin-1.75.0.crx");
+constexpr base::FilePath::CharType kBundledDir[] =
+    FILE_PATH_LITERAL("BareBundledExtensions");
+
+base::FilePath ExtractBundledCrx() {
+  base::FilePath user_data;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data)) {
+    return base::FilePath();
+  }
+
+  const base::FilePath dir = user_data.Append(kBundledDir);
+  if (!base::CreateDirectory(dir)) {
+    return base::FilePath();
+  }
+
+  const base::FilePath crx = dir.Append(kUBlockOriginCrx);
+  if (base::PathExists(crx)) {
+    return crx;
+  }
+
+  base::MemoryMappedFile::Region region;
+  const int fd = base::android::OpenApkAsset(kUBlockOriginAsset, &region);
+  if (fd < 0) {
+    base::android::DumpLastOpenApkAssetFailure();
+    LOG(ERROR) << "Bare: bundled extension asset missing: "
+               << kUBlockOriginAsset;
+    return base::FilePath();
+  }
+
+  base::File asset(fd);
+  std::vector<uint8_t> contents(static_cast<size_t>(region.size));
+  if (!asset.ReadAndCheck(region.offset, contents)) {
+    LOG(ERROR) << "Bare: could not read bundled extension asset";
+    return base::FilePath();
+  }
+
+  if (!base::WriteFile(crx, contents)) {
+    LOG(ERROR) << "Bare: could not write bundled extension to " << crx;
+    return base::FilePath();
+  }
+
+  return crx;
+}
+
+base::DictValue BuildPrefs() {
+  base::DictValue prefs;
+  const base::FilePath crx = ExtractBundledCrx();
+  if (crx.empty()) {
+    return prefs;
+  }
+
+  base::DictValue entry;
+  entry.Set("external_crx", crx.value());
+  entry.Set("external_version", kUBlockOriginVersion);
+  prefs.Set(kUBlockOriginId, std::move(entry));
+  return prefs;
+}
+
+class BundledIncognitoDefaultApplier : public ExtensionRegistryObserver {
+ public:
+  static void Start(content::BrowserContext* context) {
+    new BundledIncognitoDefaultApplier(context);
+  }
+
+  BundledIncognitoDefaultApplier(const BundledIncognitoDefaultApplier&) = delete;
+  BundledIncognitoDefaultApplier& operator=(const BundledIncognitoDefaultApplier&) = delete;
+  ~BundledIncognitoDefaultApplier() override = default;
+
+ private:
+  explicit BundledIncognitoDefaultApplier(content::BrowserContext* context)
+      : context_(context) {
+    ExtensionRegistry* registry = ExtensionRegistry::Get(context_);
+    observation_.Observe(registry);
+    if (registry->enabled_extensions().GetByID(kUBlockOriginId)) {
+      Apply();
+    }
+  }
+
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const Extension* extension) override {
+    if (extension->id() == kUBlockOriginId) {
+      Apply();
+    }
+  }
+
+  void OnShutdown(ExtensionRegistry* registry) override { Finish(); }
+
+  void Apply() {
+    if (done_) return;
+    done_ = true;
+    observation_.Reset();
+
+    ExtensionPrefs* prefs = ExtensionPrefs::Get(context_);
+    bool unused = false;
+    if (!prefs->ReadPrefAsBoolean(kUBlockOriginId, "incognito", &unused)) {
+      util::SetIsIncognitoEnabled(kUBlockOriginId, context_, true);
+    }
+    Finish();
+  }
+
+  void Finish() {
+    observation_.Reset();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+
+  raw_ptr<content::BrowserContext> context_;
+  bool done_ = false;
+  base::ScopedObservation<ExtensionRegistry, ExtensionRegistryObserver> observation_{this};
+};
+
+}  // namespace
+
+void ApplyBundledExtensionIncognitoDefault(content::BrowserContext* context) {
+  BundledIncognitoDefaultApplier::Start(context);
+}
+
BareBundledExtensionsLoader::BareBundledExtensionsLoader() = default;
+BareBundledExtensionsLoader::~BareBundledExtensionsLoader() = default;
+
+void BareBundledExtensionsLoader::StartLoading() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&BuildPrefs),
+      base::BindOnce(&BareBundledExtensionsLoader::OnPrefsBuilt, this));
+}
+
+void BareBundledExtensionsLoader::OnPrefsBuilt(base::DictValue prefs) {
+  LoadFinished(std::move(prefs));
+}
+
+}  // namespace extensions
